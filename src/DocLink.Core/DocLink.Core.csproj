<Project Sdk="Microsoft.NET.Sdk">
  <!-- MD Doc Link - core (no Navisworks refs). Author: MD (Mayank Dholariya) -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>DocLink.Core</AssemblyName>
    <RootNamespace>DocLink.Core</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>MD (Mayank Dholariya)</Authors>
    <Company>MD (Mayank Dholariya)</Company>
    <Product>MD Doc Link</Product>
    <Copyright>Copyright (c) 2026 MD (Mayank Dholariya)</Copyright>
    <Deterministic>true</Deterministic>
    <NuGetAudit>false</NuGetAudit>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Compression" Version="4.3.0" />
    <PackageReference Include="System.IO.Compression.ZipFile" Version="4.3.0" />
  </ItemGroup>
</Project>
